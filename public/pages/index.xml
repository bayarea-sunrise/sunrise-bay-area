			<item>
				<title>Biden Bingo</title>
				<link>http://localhost:1313/bidenbingo/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/bidenbingo/</guid>
				<description>&lt;div class=&#34;col col-12&#34;&gt;&#xA;    &lt;img src=&#34;http://localhost:1313/img/biden-bingo.png&#34; /&gt;&#xA;&lt;/div&gt; &#xA;&lt;div class=&#34;col col-12 col-lg-6&#34;&gt;&#xA;  &lt;h2&gt;Welcome To Office, Now Get To Work!&lt;/h2&gt;&#xA;  &lt;p&gt;&#xA;    Joe Biden has been inaugurated as the President of the United States thanks to millions of youth and people of color who turned out in November. Now it&#39;s time that President Biden delivers on this historic mandate to change the direction of this country and confront the multiple intersecting crises we face. We have 100 demands for his first 100 days. Click the link below to get your own Biden Bingo sheet with 25 randomly chosen demands and play along on social media. Post your results with the hashtag #BidenBingo, tag Sunrise Bay Area, and win prizes for scoring a row or a blackout! The demands are listed below and will be updated as they are met.&#xA;  &lt;/p&gt;</description>
			</item>
			<item>
				<title>Endorsements</title>
				<link>http://localhost:1313/endorsements/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/endorsements/</guid>
				<description>&lt;style&gt;&#xA;.endorsements-page{width:100%;max-width:1200px;margin:0 auto;padding:1rem 2rem 4rem}&#xA;.endorsements-hero{padding:4rem 1rem 3rem;text-align:center}&#xA;.endorsements-hero h1{color:#33342e;margin:0 0 1rem;font-size:clamp(2.5rem,7vw,5rem)}&#xA;.endorsements-hero p{max-width:650px;margin:0 auto;text-align:center;font-size:1.2rem}&#xA;.endorsements-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}&#xA;.endorsement-card{min-height:430px;display:flex;flex-direction:column;background:#e3eddf;border-top:12px solid #ffde16;box-shadow:0 4px 14px rgba(51,52,46,.14)}&#xA;.endorsement-photo{height:270px;background:#33342e;display:flex;align-items:center;justify-content:center}&#xA;.endorsement-photo span{color:#ffde16;font-size:1rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}&#xA;.endorsement-card-body{display:flex;flex:1;flex-direction:column;padding:1.5rem}&#xA;.endorsement-card h2{margin:0 0 .75rem;text-align:left;font-size:1.5rem;letter-spacing:.08em}&#xA;.endorsement-card p{margin:0;text-align:left;font-size:1rem;line-height:1.6}&#xA;@media(max-width:820px){.endorsements-grid{grid-template-columns:1fr 1fr}}&#xA;@media(max-width:560px){.endorsements-page{padding-left:1rem;padding-right:1rem}.endorsements-grid{grid-template-columns:1fr}.endorsement-card{min-height:360px}.endorsement-photo{height:210px}}&#xA;&lt;/style&gt;&#xA;&lt;div class=&#34;endorsements-page&#34;&gt;&#xA;  &lt;section class=&#34;endorsements-hero&#34;&gt;&#xA;    &lt;h1&gt;ENDORSEMENTS&lt;/h1&gt;&#xA;    &lt;p&gt;Meet the candidates building a livable future for the Bay Area.&lt;/p&gt;&#xA;  &lt;/section&gt;&#xA;  &lt;section class=&#34;endorsements-grid&#34; aria-label=&#34;Endorsed candidates&#34;&gt;&#xA;    &lt;article class=&#34;endorsement-card&#34;&gt;&#xA;      &lt;div class=&#34;endorsement-photo&#34;&gt;&lt;span&gt;Candidate photo coming soon&lt;/span&gt;&lt;/div&gt;&#xA;      &lt;div class=&#34;endorsement-card-body&#34;&gt;&#xA;        &lt;h2&gt;Candidate Name&lt;/h2&gt;&#xA;        &lt;p&gt;Candidate profile coming soon.&lt;/p&gt;&#xA;      &lt;/div&gt;&#xA;    &lt;/article&gt;&#xA;    &lt;article class=&#34;endorsement-card&#34;&gt;&#xA;      &lt;div class=&#34;endorsement-photo&#34;&gt;&lt;span&gt;Candidate photo coming soon&lt;/span&gt;&lt;/div&gt;&#xA;      &lt;div class=&#34;endorsement-card-body&#34;&gt;&#xA;        &lt;h2&gt;Candidate Name&lt;/h2&gt;&#xA;        &lt;p&gt;Candidate profile coming soon.&lt;/p&gt;&#xA;      &lt;/div&gt;&#xA;    &lt;/article&gt;&#xA;    &lt;article class=&#34;endorsement-card&#34;&gt;&#xA;      &lt;div class=&#34;endorsement-photo&#34;&gt;&lt;span&gt;Candidate photo coming soon&lt;/span&gt;&lt;/div&gt;&#xA;      &lt;div class=&#34;endorsement-card-body&#34;&gt;&#xA;        &lt;h2&gt;Candidate Name&lt;/h2&gt;&#xA;        &lt;p&gt;Candidate profile coming soon.&lt;/p&gt;&#xA;      &lt;/div&gt;&#xA;    &lt;/article&gt;&#xA;  &lt;/section&gt;&#xA;&lt;/div&gt;</description>
